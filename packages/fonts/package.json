	"dependencies": {
		"@verific/zod": "workspace:*",
		"dotenv": "^17.2.3"
	},
	"devDependencies": {
		"@capsizecss/metrics": "^4.3.0",
		"@types/node": "^24.9.1",
		"@verific/typescript-config": "workspace:*",
		"@vitest/coverage-v8": "^5.0.3",
		"tsx": "^4.20.6",
		"vitest": "^5.0.3"
	}
