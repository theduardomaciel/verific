{
	"$schema": "https://v2-11-7.turborepo.dev/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": [
				"VERCEL_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"NEXT_PUBLIC_VERCEL_URL",
				"NODE_ENV",
				"PORT",
				"S3_ENDPOINT",
				"S3_REGION",
				"S3_BUCKET",
				"S3_ACCESS_KEY_ID",
				"S3_SECRET_ACCESS_KEY",
				"S3_PUBLIC_BASE_URL",
				"S3_FORCE_PATH_STYLE",
				"EMAIL_PROVIDER",
				"EMAIL_FROM",
				"EMAIL_DAILY_LIMIT",
				"SES_REGION",
				"AWS_ACCESS_KEY_ID",
				"AWS_SECRET_ACCESS_KEY",
				"RESEND_API_KEY"
			],
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "../../.oxlintrc.json"],
			"outputs": []
		},
		"fmt:check": {
			"inputs": ["$TURBO_DEFAULT$", "../../.oxfmtrc.json"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "../../config/typescript/*.json"],
			"outputs": []
		},
		"test": {},
		"test:coverage": {},
		"db:generate": {},
		"db:drop": {},
		"db:push": {},
		"db:migrate": {
			"cache": false
		},
		"db:migrate:prod": {
			"cache": false
		},
		"db:studio": {},
		"db:seed": {},
		"db:seed:notifications": {
			"cache": false
		},
		"db:seed:prod": {
			"cache": false
		},
		"db:seed:minimal:prod": {
			"cache": false
		}
	}
}
