{
	"name": "@verific/load-tests",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"sessions": "tsx --env-file=../../apps/web/.env sessions.ts",
		"verify": "tsx --env-file=../../apps/web/.env verify.ts",
		"bursts": "tsx --env-file=../../apps/web/.env bursts.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p k6"
	},
	"dependencies": {
		"@verific/auth": "workspace:*",
		"@verific/drizzle": "workspace:*",
		"better-auth": "1.7.7",
		"tsx": "^4.20.6"
	},
	"devDependencies": {
		"@types/k6": "^2.3.0",
		"@types/node": "^24.9.1",
		"@verific/api": "workspace:*",
		"@verific/typescript-config": "workspace:*"
	}
}
