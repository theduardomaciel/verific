{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": [
				"VERCEL_URL",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"NEXT_PUBLIC_VERCEL_URL",
				"NODE_ENV",
				"PORT"
			],
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"test": {},
		"test:coverage": {},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"db:generate": {},
		"db:drop": {},
		"db:push": {},
		"db:migrate": {},
		"db:studio": {},
		"db:seed": {}
	}
}
