{
	"name": "@verific/api",
	"main": "./index.ts",
	"types": "./index.ts",
	"version": "0.0.0",
	"private": true,
	"exports": {
		".": "./index.ts",
		"./scheduler": "./scheduler/index.ts",
		"./schemas": "./schemas.ts",
		"./schedule-conflicts": "./schedule-conflicts.ts",
		"./notifications": "./notifications/index.ts",
		"./notifications/service": "./notifications/service.ts",
		"./waitlist": "./waitlist.ts",
		"./waitlist-plan": "./waitlist-plan.ts",
		"./seats": "./seats.ts",
		"./enrollment": "./enrollment.ts",
		"./utils": "./utils.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"email:dev": "email dev --dir ./notifications/emails --port 3001",
		"email:preview": "tsx ./notifications/preview.ts",
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1146.0",
		"@aws-sdk/client-sesv2": "^3.1150.0",
		"@aws-sdk/s3-request-presigner": "^3.1146.0",
		"@smithy/node-http-handler": "^4.12.1",
		"@trpc/server": "^11.6.0",
		"@verific/auth": "workspace:*",
		"@verific/badges": "workspace:*",
		"@verific/drizzle": "workspace:*",
		"@verific/env": "workspace:*",
		"@verific/fonts": "workspace:*",
		"@verific/zod": "workspace:*",
		"libphonenumber-js": "^1.13.14",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-email": "^6.11.1",
		"resend": "^6.32.1",
		"server-only": "^0.0.1",
		"superjson": "^2.2.2"
	},
	"devDependencies": {
		"@react-email/ui": "^6.11.1",
		"@types/node": "^24.9.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@verific/typescript-config": "workspace:*",
		"@vitest/coverage-v8": "^5.0.3",
		"next": "16.4.0",
		"tsx": "^4.20.6",
		"vitest": "^5.0.3"
	}
}
