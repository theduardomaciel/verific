{
	"name": "@verific/fonts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./catalog": "./catalog.ts",
		"./validation": "./validation.ts",
		"./aspects": "./aspects.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
