{
	"name": "verific",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"config/*"
	],
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"lint:type-aware": "oxlint -c .oxlintrc.typeaware.json --type-aware",
		"fmt": "oxfmt",
		"fmt:check": "turbo run fmt:check",
		"typecheck": "turbo run typecheck",
		"check:time-zones": "node scripts/check-time-zones.mjs",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:migrate:prod": "turbo run db:migrate:prod",
		"db:studio": "turbo run db:studio",
		"db:drop": "turbo run db:drop",
		"db:seed": "turbo run db:seed",
		"db:seed:notifications": "turbo run db:seed:notifications",
		"db:seed:logs": "turbo run db:seed:logs",
		"db:seed:prod": "turbo run db:seed:prod",
		"db:seed:minimal:prod": "turbo run db:seed:minimal:prod",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"turbo": "2.11.9",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
			"oxfmt --write --no-error-on-unmatched-pattern",
			"oxlint"
		],
		"*.{json,jsonc,css,md,mdx,yaml,yml}": [
			"oxfmt --write --no-error-on-unmatched-pattern"
		]
	},
	"dependencies": {
		"@upstash/qstash": "^2.12.0"
	}
}
